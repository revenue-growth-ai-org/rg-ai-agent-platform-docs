# AWS Agent Platform — Customer Deployment Defaults (example)
# Copy to defaults.env (gitignored) or let install.sh generate that file.
# This example is the schema operators and tooling should treat as current.

PROJECT_NAME="acme-corp"
ENVIRONMENT="prod"
DOMAIN_NAME="example.com"
ALLOWED_CIDR="203.0.113.0/24"
AWS_REGION="us-east-1"
# Account this platform was installed into. destroy.sh refuses to run against
# any other account (guard added 2026-08-04 after a wrong-account near-miss).
EXPECTED_ACCOUNT_ID="123456789012"
COST_CENTER="unallocated"
OWNER="platform-engineering"
CRM_TYPE="hubspot"
# Salesforce org IDs allowed to send webhooks (CRM_TYPE=salesforce only).
SALESFORCE_ORG_IDS=""

# ECS cluster name is ${PROJECT_NAME}-${ENVIRONMENT}-ecs (the -ecs suffix
# is required). Example: acme-corp-prod-ecs

# OBSOLETE — terraform-deploy role deleted; no script reads this. Do not set.
# If an older defaults.env still has a live DEPLOYMENT_ROLE_ARN=... line,
# comment it out or delete it so it is not mistaken for current config.
# DEPLOYMENT_ROLE_ARN=
